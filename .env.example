# Ключ Mistral API: https://console.mistral.ai/api-keys
# Скопируй файл в .env и вставь свой ключ. Файл .env в git не попадает.
MISTRAL_API_KEY=

# Необязательно. Модель Mistral, по умолчанию ministral-14b-latest
# MISTRAL_MODEL=ministral-14b-latest

# Аккаунты (Supabase). Без них войти нельзя: работают только дыхание и «Живая помощь».
# Project Settings → Data API: Project URL. Project Settings → API Keys: publishable key
# (sb_publishable_…) или старый anon key (eyJ…), подходит любой.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Только для сервера: нужен, чтобы удалить аккаунт по просьбе пользователя.
# Project Settings → API Keys: secret key (sb_secret_…) или старый service_role.
# Никогда не добавляй его в клиентский код.
SUPABASE_SECRET_KEY=

# Почта для писем Supabase Auth: подтверждение регистрации и сброс пароля.
# Письма отправляет Supabase, а не наше приложение, поэтому код эти переменные не читает
# и в Vercel их добавлять не нужно. Они собраны здесь, чтобы значения лежали в одном месте:
# перенеси их в Supabase → Authentication → Emails → SMTP Settings (подробно в README).
# Примеры: Resend — smtp.resend.com, порт 465, пользователь resend, пароль — API-ключ;
# Gmail — smtp.gmail.com, порт 587, пароль приложения (не обычный пароль от почты).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Адрес отправителя: домен должен быть подтверждён у почтового сервиса
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Паника-режим
